#
# Regenerate the decoder after editing this file:
#   cmake --build build --target gen_decode
#

#
#   regs_16_31_by_one = [16 .. 31]
#   regs_16_23_by_one = [16 .. 23]
#   regs_24_30_by_two = [24, 26, 28, 30]
#   regs_00_30_by_two = [0, 2, 4, 6, 8, .. 30]

%rd             4:5
%rr             9:1 0:4

%rd_a           4:4                         !function=ToRegs16To31ByOne
%rd_b           4:3                         !function=ToRegs16To23ByOne
%rd_c           4:2                         !function=ToRegs24To30ByTwo
%rr_a           0:4                         !function=ToRegs16To31ByOne
%rr_b           0:3                         !function=ToRegs16To23ByOne

%imm6           6:2 0:4
%imm8           8:4 0:4

%io_imm         9:2 0:4
%ldst_d_imm     13:1 10:2 0:3


&none
&rd             rd
&rr             rr
&bit            bit
&imm            imm
&rd_rr          rd rr
&rd_imm         rd imm
&rd_bit         rd bit
&rr_bit         rr bit
&reg_bit        reg bit
&imm_bit        imm bit

@op_rd_rr       .... .. . ..... ....        &rd_rr      rd=%rd rr=%rr
@op_rd_imm6     .... .... .. .. ....        &rd_imm     rd=%rd_c imm=%imm6
@op_rd_imm8     .... .... .... ....         &rd_imm     rd=%rd_a imm=%imm8
@fmul           .... .... . ... . ...       &rd_rr      rd=%rd_b rr=%rr_b

#
# Arithmetic Instructions
#
ADD             0000 11 . ..... ....        @op_rd_rr
ADC             0001 11 . ..... ....        @op_rd_rr
ADIW            1001 0110 .. .. ....        @op_rd_imm6
SUB             0001 10 . ..... ....        @op_rd_rr
SUBI            0101 .... .... ....         @op_rd_imm8
SBC             0000 10 . ..... ....        @op_rd_rr
SBCI            0100 .... .... ....         @op_rd_imm8
SBIW            1001 0111 .. .. ....        @op_rd_imm6
AND             0010 00 . ..... ....        @op_rd_rr
ANDI            0111 .... .... ....         @op_rd_imm8
OR              0010 10 . ..... ....        @op_rd_rr
ORI             0110 .... .... ....         @op_rd_imm8
EOR             0010 01 . ..... ....        @op_rd_rr
COM             1001 010 rd:5 0000          &rd
NEG             1001 010 rd:5 0001          &rd
INC             1001 010 rd:5 0011          &rd
DEC             1001 010 rd:5 1010          &rd
MUL             1001 11 . ..... ....        @op_rd_rr
MULS            0000 0010 .... ....         &rd_rr      rd=%rd_a rr=%rr_a
MULSU           0000 0011 0 ... 0 ...       @fmul
FMUL            0000 0011 0 ... 1 ...       @fmul
FMULS           0000 0011 1 ... 0 ...       @fmul
FMULSU          0000 0011 1 ... 1 ...       @fmul
# DES             1001 0100 imm:4 1011    # Not part of ATmega328P

#
# Branch Instructions
#

# The 22-bit immediate is partially in the opcode word,
# and partially in the next.  Use Append16 to build the
# complete 22-bit value.
%imm_call       4:5 0:1                     !function=Append16

@op_bit         .... .... . bit:3 ....        &bit
@op_bit_imm     .... .. imm:s7 bit:3         &imm_bit

RJMP            1100 imm:s12                &imm
IJMP            1001 0100 0000 1001         &none
EIJMP           1001 0100 0001 1001         &none
JMP             1001 010 ..... 110 .        &imm        imm=%imm_call
RCALL           1101 imm:s12                &imm
ICALL           1001 0101 0000 1001         &none
EICALL          1001 0101 0001 1001         &none
CALL            1001 010 ..... 111 .        &imm        imm=%imm_call
RET             1001 0101 0000 1000         &none
RETI            1001 0101 0001 1000         &none
CPSE            0001 00 . ..... ....        @op_rd_rr
CP              0001 01 . ..... ....        @op_rd_rr
CPC             0000 01 . ..... ....        @op_rd_rr
CPI             0011 .... .... ....         @op_rd_imm8
SBRC            1111 110 rr:5 0 bit:3       &rr_bit
SBRS            1111 111 rr:5 0 bit:3       &rr_bit
SBIC            1001 1001 reg:5 bit:3       &reg_bit
SBIS            1001 1011 reg:5 bit:3       &reg_bit
BRBS            1111 00 ....... ...         @op_bit_imm
BRBC            1111 01 ....... ...         @op_bit_imm

#
# Data Transfer Instructions
#

%rd_d           4:4                         !function=ToRegs00To30ByTwo
%rr_d           0:4                         !function=ToRegs00To30ByTwo

@io_rd_imm      .... . .. ..... ....        &rd_imm     rd=%rd imm=%io_imm
@ldst_d         .. . . .. . rd:5  . ...     &rd_imm     imm=%ldst_d_imm

%ldst_imm       !function=NextWord
@ldst_s         .... ... rd:5 ....          &rd_imm     imm=%ldst_imm

MOV             0010 11 . ..... ....        @op_rd_rr
MOVW            0000 0001 .... ....         &rd_rr      rd=%rd_d rr=%rr_d
LDI             1110 .... .... ....         @op_rd_imm8
LDS             1001 000 ..... 0000         @ldst_s
LDX1            1001 000 rd:5 1100          &rd
LDX2            1001 000 rd:5 1101          &rd
LDX3            1001 000 rd:5 1110          &rd
LDY2            1001 000 rd:5 1001          &rd
LDY3            1001 000 rd:5 1010          &rd
LDZ2            1001 000 rd:5 0001          &rd
LDZ3            1001 000 rd:5 0010          &rd
LDDY            10 . 0 .. 0 ..... 1 ...     @ldst_d
LDDZ            10 . 0 .. 0 ..... 0 ...     @ldst_d
STS             1001 001 ..... 0000         @ldst_s
STX1            1001 001 rr:5 1100          &rr
STX2            1001 001 rr:5 1101          &rr
STX3            1001 001 rr:5 1110          &rr
STY2            1001 001 rr:5 1001          &rr
STY3            1001 001 rr:5 1010          &rr
STZ2            1001 001 rr:5 0001          &rr
STZ3            1001 001 rr:5 0010          &rr
STDY            10 . 0 .. 1 ..... 1 ...     @ldst_d
STDZ            10 . 0 .. 1 ..... 0 ...     @ldst_d
LPM1            1001 0101 1100 1000         &none
LPM2            1001 000 rd:5 0100          &rd
LPMX            1001 000 rd:5 0101          &rd
# ELPM1           1001 0101 1101 1000       # Not part of ATmega328P
# ELPM2           1001 000 rd:5 0110        # Not part of ATmega328P
# ELPMX           1001 000 rd:5 0111        # Not part of ATmega328P
SPM             1001 0101 1110 1000         &none
SPMX            1001 0101 1111 1000         &none
IN              1011 0 .. ..... ....        @io_rd_imm
OUT             1011 1 .. ..... ....        @io_rd_imm
PUSH            1001 001 rd:5 1111          &rd
POP             1001 000 rd:5 1111          &rd
XCH             1001 001 rd:5 0100          &rd
LAC             1001 001 rd:5 0110          &rd
LAS             1001 001 rd:5 0101          &rd
LAT             1001 001 rd:5 0111          &rd

#
# Bit and Bit-test Instructions
#
LSR             1001 010 rd:5 0110          &rd
ROR             1001 010 rd:5 0111          &rd
ASR             1001 010 rd:5 0101          &rd
SWAP            1001 010 rd:5 0010          &rd
SBI             1001 1010 reg:5 bit:3       &reg_bit
CBI             1001 1000 reg:5 bit:3       &reg_bit
BST             1111 101 rd:5 0 bit:3       &rd_bit
BLD             1111 100 rd:5 0 bit:3       &rd_bit
BSET            1001 0100 0 bit:3 1000
BCLR            1001 0100 1 bit:3 1000

#
# MCU Control Instructions
#
BREAK           1001 0101 1001 1000         &none
NOP             0000 0000 0000 0000         &none
SLEEP           1001 0101 1000 1000         &none
WDR             1001 0101 1010 1000         &none